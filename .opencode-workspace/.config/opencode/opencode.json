{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "snapshot": false,
  "provider": {
    "shirty": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Shirty LiteLLM",
      "options": {
        "baseURL": "http://proxy:4000/v1",
        "apiKey": "{env:SHIRTY_API_KEY}"
      },
      "models": {
        "mistral/devstral-2-123B": {
          "name": "Devstral 2 123B",
          "limit": {
            "context": 256000,
            "output": 16384
          }
        },
        "google/gemma-4-31B-it": {
          "name": "Gemma 4 31B",
          "limit": {
            "context": 256000,
            "output": 16384
          }
        }
      }
    }
  },
  "model": "shirty/google/gemma-4-31B-it",
  "small_model": "shirty/google/gemma-4-31B-it",
  "disabled_providers": [
    "openai",
    "anthropic",
    "google",
    "openrouter",
    "groq",
    "xai",
    "deepseek",
    "opencode"
  ],
  "plugin": []
}