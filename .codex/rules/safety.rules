# =============================================================================
# Codex Execution Policy Rules - Sandia Sandboxed Container
# =============================================================================
# Place at: ~/.codex/rules/safety.rules
# Pre-seeded into /etc/agent-configs/codex/rules/ at build time.
# Entrypoint copies to /root/.codex/rules/safety.rules at startup.
#
# These rules add command-level guardrails on top of the OS sandbox (Landlock).
# The container network + nginx proxy sidecar handle network-level policy;
# these rules handle "what shell commands can the agent run" policy.
#
# Decision precedence: forbidden > prompt > allow
# Rules use prefix matching against the command's parsed argument list.
#
# Ref: https://developers.openai.com/codex/exec-policy
# =============================================================================

# ==============================================================================
# FORBIDDEN: Hard-blocked commands. These never run, period.
# ==============================================================================

# -- Recursive force-delete: the single most dangerous command --
prefix_rule(
    pattern = ["rm", ["-rf", "-fr"]],
    decision = "forbidden",
    justification = "Recursive force-delete is too destructive even in a container",
    match = [
        "rm -rf /",
        "rm -rf .",
        "rm -rf src/",
        "rm -fr some_directory",
    ],
    not_match = [
        "rm file.txt",
        "rm -f file.txt",
        "rm -r build/",
    ],
)

# -- Privilege escalation --
prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "No privilege escalation in sandboxed container",
    match = [
        "sudo rm -rf /",
        "sudo apt install something",
        "sudo pip install requests",
    ],
)

prefix_rule(
    pattern = ["su"],
    decision = "forbidden",
    justification = "No user switching in sandboxed container",
    match = ["su root", "su - root"],
)

# -- Recursive permission changes --
prefix_rule(
    pattern = [["chmod", "chown"], ["-R", "--recursive"]],
    decision = "forbidden",
    justification = "Recursive permission changes are dangerous",
    match = ["chmod -R 777 /", "chown -R root:root /"],
)

# -- Disk/partition/system tools --
prefix_rule(
    pattern = [["mkfs", "mkfs.ext4", "mkfs.vfat", "mkfs.xfs", "fdisk", "parted", "dd"]],
    decision = "forbidden",
    justification = "Disk manipulation tools are never needed in a dev container",
    match = ["mkfs.ext4 /dev/sda1", "dd if=/dev/zero of=/dev/sda"],
)

prefix_rule(
    pattern = [["shutdown", "reboot", "halt", "poweroff", "init"]],
    decision = "forbidden",
    justification = "System control commands are not needed in a dev container",
    match = ["shutdown -h now", "reboot"],
)

# ==============================================================================
# PROMPT: Allowed but deserve a second look before running.
# ==============================================================================

# -- Git history rewriting --
prefix_rule(
    pattern = ["git", "push", ["-f", "--force", "--force-with-lease", "--force-if-includes"]],
    decision = "prompt",
    justification = "Force-push rewrites remote history",
    match = ["git push -f origin main", "git push --force origin feature"],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Hard reset discards uncommitted changes",
    match = ["git reset --hard HEAD~1", "git reset --hard origin/main"],
    not_match = ["git reset HEAD file.txt", "git reset --soft HEAD~1"],
)

# -- Recursive delete without force: confirm target is intended --
prefix_rule(
    pattern = ["rm", "-r"],
    decision = "prompt",
    justification = "Recursive delete; confirm target is intended",
    match = ["rm -r build/", "rm -r node_modules/"],
    not_match = ["rm file.txt"],
)

# -- Direct network tools: proxy handles routing, but worth confirming --
# These will mostly fail or hit the proxy anyway, but prompting catches
# accidental data exfil attempts or confused agent behavior.
prefix_rule(
    pattern = [["curl", "wget"]],
    decision = "prompt",
    justification = "Network tools route through proxy; confirm intended use",
    match = ["curl https://example.com", "wget https://example.com/file.tar.gz"],
)

prefix_rule(
    pattern = [["nc", "netcat", "ncat", "ssh", "scp", "rsync", "sftp"]],
    decision = "prompt",
    justification = "Remote access tools; confirm intended use",
    match = ["ssh user@host", "scp file.txt user@host:/tmp/", "nc -l 8080"],
)

# ==============================================================================
# ALLOW: Common safe operations for autonomous coding workflows.
# ==============================================================================

# -- Git operations --
prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show", "branch", "tag", "remote", "stash", "blame", "shortlog", "describe", "rev-parse", "ls-files", "ls-tree"]],
    decision = "allow",
    match = ["git status", "git diff HEAD", "git log --oneline -10", "git branch -a"],
)

prefix_rule(
    pattern = ["git", ["add", "commit", "checkout", "switch", "merge", "rebase", "cherry-pick", "fetch", "pull", "push", "clean", "restore"]],
    decision = "allow",
    match = ["git add .", "git commit -m 'fix: update handler'", "git push origin main"],
)

# -- Python --
prefix_rule(
    pattern = [["python", "python3"]],
    decision = "allow",
    match = ["python script.py", "python3 -m pytest", "python -c 'print(1)'"],
)

# -- Package managers: allowed because they route through the proxy sidecar --
# The nginx proxy only forwards to approved registries (PyPI, npm, crates.io).
# Direct internet is blocked at the container network level.
prefix_rule(
    pattern = [["pip", "pip3"]],
    decision = "allow",
    match = [
        "pip install requests",
        "pip install -r requirements.txt",
        "pip list",
        "pip freeze",
        "pip3 install flask",
    ],
)

prefix_rule(
    pattern = ["npm"],
    decision = "allow",
    match = ["npm install express", "npm install", "npm test", "npm run build", "npm list"],
)

prefix_rule(
    pattern = [["cargo", "rustup"]],
    decision = "allow",
    match = ["cargo build", "cargo test", "cargo add serde", "rustup show"],
)

prefix_rule(
    pattern = ["go"],
    decision = "allow",
    match = ["go build ./...", "go test ./...", "go mod tidy", "go get github.com/pkg/errors"],
)

# -- Build, test, and lint tools --
prefix_rule(
    pattern = [["make", "cmake", "pytest", "mypy", "ruff", "black", "isort", "flake8", "pylint", "tox", "nox", "pre-commit"]],
    decision = "allow",
    match = ["make build", "pytest -v tests/", "ruff check .", "mypy src/", "black ."],
)

prefix_rule(
    pattern = ["npx"],
    decision = "allow",
    match = ["npx prettier --write .", "npx tsc --noEmit"],
)

# -- File inspection and manipulation --
prefix_rule(
    pattern = [["cat", "head", "tail", "less", "more", "wc", "file", "stat", "ls", "find", "tree", "grep", "rg", "ag", "awk", "sed", "sort", "uniq", "cut", "tr", "tee", "diff", "comm", "jq", "yq", "xxd", "hexdump", "strings"]],
    decision = "allow",
    match = ["cat README.md", "grep -r 'TODO' src/", "find . -name '*.py'", "jq '.version' package.json"],
)

# -- Non-destructive file management --
prefix_rule(
    pattern = [["mkdir", "cp", "mv", "touch", "ln"]],
    decision = "allow",
    match = ["mkdir -p src/utils", "cp config.example.toml config.toml", "touch __init__.py"],
)

# -- Single-file rm (non-recursive) --
prefix_rule(
    pattern = ["rm"],
    decision = "allow",
    match = ["rm file.txt", "rm -f stale_lock.pid"],
)

# -- Shell utilities --
prefix_rule(
    pattern = [["echo", "printf", "date", "env", "printenv", "which", "whoami", "pwd", "id", "uname", "basename", "dirname", "realpath", "readlink", "xargs", "true", "false", "test", "expr"]],
    decision = "allow",
    match = ["echo 'hello'", "which python3", "pwd", "env"],
)

# -- Archive tools --
prefix_rule(
    pattern = [["tar", "zip", "unzip", "gzip", "gunzip", "bzip2", "xz"]],
    decision = "allow",
    match = ["tar czf archive.tar.gz src/", "unzip data.zip"],
)

# -- Process inspection (read-only) --
prefix_rule(
    pattern = [["ps", "top", "htop", "free", "df", "du", "lsof", "uptime"]],
    decision = "allow",
    match = ["ps aux", "df -h", "du -sh src/", "free -m"],
)
